# Copy to .env. Use unquoted KEY=value entries for Spring Boot and Docker Compose.
POSTGRES_DB=polychat
POSTGRES_USER=polychat
POSTGRES_PASSWORD=polychat-local-dev
POSTGRES_PORT=5432
SERVER_PORT=8080

# Local development only. Replace with a random value of at least 32 characters.
JWT_SECRET=polychat-local-development-secret-replace-with-random-value
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides when running against an external database:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/polychat
# SPRING_DATASOURCE_USERNAME=polychat
# SPRING_DATASOURCE_PASSWORD=polychat-local-dev
